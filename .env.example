# LLM 后端（OpenAI 兼容协议）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 靶场平台（TSecBench）
BENCHMARK_BASE_URL=https://tsecbench.zc.tencent.com
BENCHMARK_TOKEN=

# 本地安全 CLI 工具 YAML 目录（本地自包含）
TOOLS_DIR=/home/kali/SECAI/tools

# OpenVPN 连接（任务需要走 VPN/内网时，由 Agent 调用 connect_vpn 后台启用）
VPN_CONFIG=
