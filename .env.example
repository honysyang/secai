# LLM 后端（OpenAI 兼容协议）
# 主模型示例：百度 glm-5.2-agent-chanllenge（OpenAI 兼容网关）
LLM_API_KEY=YOUR_BAIDU_API_KEY
LLM_BASE_URL=https://agent-awd.baidu.com
LLM_MODEL=glm-5.2-agent-chanllenge

# 靶场平台（TSecBench）
BENCHMARK_BASE_URL=https://tsecbench.zc.tencent.com
BENCHMARK_TOKEN=

# 本地安全 CLI 工具 YAML 目录（可选；留空或删除则自动使用 arsenal/tools/）
# TOOLS_DIR=arsenal/tools

# 灾备模型池（JSON 列表）：当主模型额度/限流/失败/无进展时自动切换候选模型
# 示例：主模型为百度 glm-5.2-agent-chanllenge，备用模型为 deepseek-chat
ESCALATION_MODELS=[{"model":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key":"YOUR_DEEPSEEK_API_KEY","role":"backup"}]

# OpenVPN 连接（任务需要走 VPN/内网时，由 Agent 调用 connect_vpn 后台启用）
VPN_CONFIG=
# VPN_AUTH=
# VPN_CMD=openvpn

# 模型惰性治理（可选，均有默认值，见 runtime/stuck.py）
# 策略：连续 zero_gain 达到阈值后，优先进行单模型自救换思路；
#       自救次数用尽仍无进展时，若配置了灾备模型则切换模型接管。
# MODEL_SWITCH_TURNS=6      # 连续多少轮 zero_gain 触发模型切换/自救
# MODEL_SELF_RESCUE_MAX=2   # 连续无进展时最多自救几次（之后切换灾备模型或交调度器 hint/skip）

# 成本治理（可选，均有默认值，见 budget.py）
# BRUTEFORCE_MAX_CALLS=20   # 每题爆破/枚举调用硬上限，0=关闭
# HINT_BUDGET_RATIO=0.35    # 卡题且 token 达挂起档该比例时拉 hint，0=关闭
# SUSPEND_SECONDS=2700      # 墙上时钟挂起档（秒），0=关闭
