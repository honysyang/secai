# 托管模式环境变量示例（镜像上传后，平台会在运行时注入）
# 本地跑分时复制为 .env 并填值；托管模式上传镜像时，把除 BENCHMARK_* 外的变量贴到平台。

# ========== 大模型网关（必填） ==========
# 平台托管时这里填你白名单/自备的模型网关；支持 OpenAI 兼容协议。
# BASE_URL 可省略末尾 /v1，代码会自动补齐。
LLM_API_KEY=YOUR_API_KEY
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ========== 靶场平台（托管时由平台自动分发，无需手动填） ==========
# BENCHMARK_BASE_URL=https://tsecbench.example.com
# BENCHMARK_TOKEN=will_be_injected_by_platform

# ========== 灾备模型池（可选但建议配） ==========
# 主模型额度/限流/失败/卡顿时自动切换候选模型。
# JSON 列表，每个条目：model / base_url / api_key / role（backup|reasoning|cheap）
# ESCALATION_MODELS=[{"model":"gpt-4o","base_url":"https://api.openai.com/v1","api_key":"YOUR_OPENAI_KEY","role":"reasoning"}]

# ========== OpenVPN（需要 VPN/内网靶场时填） ==========
# 建议把 .ovpn 文件内容完整粘贴到 VPN_CONFIG，Agent 会在连接时写入临时文件。
# VPN_CONFIG=<粘贴 ovpn 完整内容>
# VPN_AUTH=<用户名>\n<密码>
# VPN_CMD=openvpn

# ========== 模型惰性治理（可选，均有默认值） ==========
# MODEL_SWITCH_TURNS=6      # 连续多少轮 zero_gain 触发模型切换/自救
# MODEL_SELF_RESCUE_MAX=2   # 连续无进展时最多自救几次（之后切换灾备模型或交调度器 hint/skip）

# ========== 成本治理（可选，均有默认值） ==========
# BRUTEFORCE_MAX_CALLS=20   # 每题爆破/枚举调用硬上限，0=关闭
# HINT_BUDGET_RATIO=0.35    # 卡题且 token 达挂起档该比例时拉 hint，0=关闭
# SUSPEND_SECONDS=2700      # 墙上时钟挂起档（秒），0=关闭

# ========== 本地调试（可选） ==========
# 本地安全 CLI 工具 YAML 目录（留空或删除则自动使用 arsenal/tools/）
# TOOLS_DIR=arsenal/tools
